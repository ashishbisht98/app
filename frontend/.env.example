# Frontend Environment Variables
# This file is used at BUILD TIME by Create React App
# Copy to .env.local for local development
# For Vercel, set these in the project settings

# ========== API ==========
# Backend URL - must be set for API calls to work
# Local development:
REACT_APP_BACKEND_URL=http://localhost:3000
# Production (example):
# REACT_APP_BACKEND_URL=https://your-api.vercel.app/api
