# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ========== RAZORPAY ==========
# Get these from https://dashboard.razorpay.com/app/keys
# For LIVE mode, use your live keys (Key ID starts with rzp_live_)
# For TEST mode, use rzp_test_placeholder and placeholder_secret
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
REGISTRATION_FEE_PAISE=10000

# ========== FIREBASE ==========
# Get from https://console.firebase.google.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./firebase-admin.json

# ========== CORS ==========
# Frontend URL(s) - comma-separated if multiple
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# ========== OPTIONAL ==========
# Port (if not using default 8000)
# PORT=8000
